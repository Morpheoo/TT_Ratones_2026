# Configuracion instalada en cada PC. No contiene secretos.
DB_BACKEND=sqlite

# Si se omite, la base se crea en:
# %LOCALAPPDATA%\TT_Ratones_2026\data\tt_ratones.db
SQLITE_DB_PATH=

# El primer usuario registrado en una base vacia se convierte en admin
# y todas las cuentas locales se verifican sin correo OTP.
TT_OFFLINE_INSTALL=1
