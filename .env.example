# ===================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===================================================================

# --- OPCIÓN 1: Base de Datos LOCAL (Docker) ---
# Usa esto si estás ejecutando PostgreSQL en tu máquina local con Docker
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=ratones_lab
DB_HOST=localhost
DB_PORT=5432

# --- OPCIÓN 2: Base de Datos REMOTA (Producción) ---
# Descomenta y configura una de estas opciones para base de datos en línea:

# SUPABASE (Recomendado para desarrollo)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=tu_password_seguro
# POSTGRES_DB=postgres
# DB_HOST=db.xxxxxxxxxxxxx.supabase.co
# DB_PORT=5432

# RAILWAY
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=tu_railway_password
# POSTGRES_DB=railway
# DB_HOST=xxxxx.railway.app
# DB_PORT=5432

# RENDER
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=tu_render_password
# POSTGRES_DB=ratones_lab
# DB_HOST=dpg-xxxxx-a.oregon-postgres.render.com
# DB_PORT=5432

# AWS RDS
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=tu_aws_password
# POSTGRES_DB=ratones_lab
# DB_HOST=xxxxx.xxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432

# ===================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ===================================================================
# Necesario para enviar OTPs reales a usuarios al registrarse.
# Si dejás los placeholders, el sistema imprime el OTP en consola
# (modo DEV) y permite completar el registro sin SMTP.
#
# Para SMTP real con Gmail:
#   1. Activá verificación en 2 pasos en tu cuenta Google.
#   2. Generá una "Contraseña de aplicación" en
#      https://myaccount.google.com/apppasswords
#   3. Pegala abajo en GMAIL_APP_PASSWORD (16 caracteres sin espacios).
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# ===================================================================
# ADMIN INICIAL (primer arranque)
# ===================================================================
# Si la tabla `users` está vacía al arrancar, start_services.py crea
# un admin con estos datos para que puedas hacer login al primer boot
# sin necesitar SMTP funcional. Cambiá el password DESPUÉS del primer
# login desde el Panel Admin.
#
# Si dejás los placeholders, el seed se saltea (no se crea admin
# automático) y vas a tener que registrarte manualmente vía la UI.
INITIAL_ADMIN_EMAIL=tu_email@ipn.mx
INITIAL_ADMIN_PASSWORD=cambiar_despues_del_primer_login
